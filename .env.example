# Template for the U.S. Alpaca collector. Put account values in the local .env read by
# the notebook, or export them in the shell that launches the CLI. The two market-data
# requests share credentials. The optional base URL selects the contract catalog host.
# The Amsterdam public trade collector and the synthetic demo run without these variables.
export APCA_API_KEY_ID=
export APCA_API_SECRET_KEY=
# Optional override for contract metadata when your dashboard uses a different key environment.
# export APCA_API_BASE_URL=https://paper-api.alpaca.markets
